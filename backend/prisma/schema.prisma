datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  TEAM_MANAGER
  EMPLOYEE
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SOPCategory {
  POLICY
  COMMUNICATION
  MEETING
  TOOLING
  ESCALATION
  ONBOARDING
  GENERAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SOPStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum WorkflowCategory {
  ONBOARDING
  REPORTING
  INCIDENT
  HANDOVER
  POLICY_APPROVAL
  CUSTOM
}

enum WorkflowStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrainingCategory {
  REMOTE_FUNDAMENTALS
  ASYNC_COMMUNICATION
  EFFECTIVE_DOCUMENTATION
  DISTRIBUTED_COLLABORATION
  TIMEZONE_MANAGEMENT
  REMOTE_LEADERSHIP
  DIGITAL_ETIQUETTE
  OPERATIONAL_EXCELLENCE
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  ARTICLE
  VIDEO
  SOP_LINK
  INTERACTIVE
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum WorkshopStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  SOP_ASSIGNED
  SOP_PUBLISHED
  SOP_REMINDER
  TRAINING_ASSIGNED
  TRAINING_DEADLINE
  WORKSHOP_INVITE
  WORKSHOP_REMINDER
  WORKFLOW_ASSIGNED
  WORKFLOW_APPROVAL
  ORG_INVITE
  GENERAL
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  passwordHash         String
  firstName            String
  lastName             String
  avatarUrl            String?
  jobTitle             String?
  timezone             String                 @default("UTC")
  isEmailVerified      Boolean                @default(false)
  emailVerifyToken     String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  memberships          OrganizationMember[]
  createdOrganizations Organization[]         @relation("OrgCreator")
  sessions             UserSession[]
  sopsCreated          SOP[]                  @relation("SOPCreator")
  sopVersionsCreated   SOPVersion[]           @relation("SOPVersionCreator")
  sopAcknowledgements  SOPAcknowledgement[]
  sopComments          SOPComment[]
  sopAssignments       SOPAssignment[]        @relation("UserSOPAssignment")
  workflowsCreated     Workflow[]             @relation("WorkflowCreator")
  assignedTasks        WorkflowTask[]         @relation("TaskAssignee")
  reportedTasks        WorkflowTask[]         @relation("TaskReporter")
  workflowApprovals    WorkflowApproval[]     @relation("TaskApprover")
  workflowComments     WorkflowComment[]
  trainingsCreated     TrainingProgram[]      @relation("TrainingCreator")
  enrollments          TrainingEnrollment[]
  quizAttempts         QuizAttempt[]
  workshopsInstructed  Workshop[]             @relation("WorkshopInstructor")
  workshopRegs         WorkshopRegistration[]
  workshopAttendance   WorkshopAttendance[]
  workshopFeedback     WorkshopFeedback[]
  notifications        Notification[]
  activityLogs         ActivityLog[]

  @@index([email])
}

model Organization {
  id                 String               @id @default(uuid())
  name               String
  slug               String               @unique
  logoUrl            String?
  domain             String?
  plan               String               @default("ENTERPRISE")
  subscriptionStatus String               @default("ACTIVE")
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  createdBy          User                 @relation("OrgCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members            OrganizationMember[]
  departments        Department[]
  teams              Team[]
  invitations        Invitation[]
  sops               SOP[]
  sopAssignments     SOPAssignment[]
  sopAcknowledgements SOPAcknowledgement[]
  workflows          Workflow[]
  trainingPrograms   TrainingProgram[]
  enrollments        TrainingEnrollment[]
  workshops          Workshop[]
  notifications      Notification[]
  activityLogs       ActivityLog[]
  subscriptions      Subscription[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(EMPLOYEE)
  status         MemberStatus @default(ACTIVE)
  departmentId   String?
  teamId         String?
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Department {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  teams          Team[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id             String               @id @default(uuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?
  leadId         String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members        OrganizationMember[]
  sopAssignments SOPAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           Role         @default(EMPLOYEE)
  departmentId   String?
  teamId         String?
  token          String       @unique
  expiresAt      DateTime
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  invitedById    String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@index([email])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  isRevoked    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model SOP {
  id                   String               @id @default(uuid())
  organizationId       String
  title                String
  summary              String
  category             SOPCategory          @default(GENERAL)
  priority             Priority             @default(MEDIUM)
  status               SOPStatus            @default(DRAFT)
  currentVersionNumber Int                  @default(1)
  createdById          String
  publishedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy            User                 @relation("SOPCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions             SOPVersion[]
  assignments          SOPAssignment[]
  acknowledgements     SOPAcknowledgement[]
  comments             SOPComment[]

  @@index([organizationId])
  @@index([category])
  @@index([status])
}

model SOPVersion {
  id            String               @id @default(uuid())
  sopId         String
  versionNumber Int
  title         String
  content       String               // Markdown or rich JSON content
  changelog     String?
  checklist     Json?                // Array of checklist items { id, text, required }
  createdById   String
  createdAt     DateTime             @default(now())

  sop           SOP                  @relation(fields: [sopId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation("SOPVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acknowledgements SOPAcknowledgement[]

  @@unique([sopId, versionNumber])
  @@index([sopId])
}

model SOPAssignment {
  id             String       @id @default(uuid())
  sopId          String
  organizationId String
  teamId         String?
  userId         String?
  assignedById   String
  dueDate        DateTime?
  createdAt      DateTime     @default(now())

  sop            SOP          @relation(fields: [sopId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User?        @relation("UserSOPAssignment", fields: [userId], references: [id], onDelete: Cascade)

  @@index([sopId])
  @@index([organizationId])
  @@index([userId])
  @@index([teamId])
}

model SOPAcknowledgement {
  id             String       @id @default(uuid())
  sopId          String
  sopVersionId   String
  organizationId String
  userId         String
  acknowledgedAt DateTime     @default(now())
  ipAddress      String?
  userAgent      String?

  sop            SOP          @relation(fields: [sopId], references: [id], onDelete: Cascade)
  sopVersion     SOPVersion   @relation(fields: [sopVersionId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sopId, userId, sopVersionId])
  @@index([sopId])
  @@index([userId])
  @@index([organizationId])
}

model SOPComment {
  id        String       @id @default(uuid())
  sopId     String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sop       SOP          @relation(fields: [sopId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    SOPComment?  @relation("ThreadedComments", fields: [parentId], references: [id], onDelete: Cascade)
  replies   SOPComment[] @relation("ThreadedComments")

  @@index([sopId])
}

model Workflow {
  id             String           @id @default(uuid())
  organizationId String
  title          String
  description    String?
  category       WorkflowCategory @default(CUSTOM)
  priority       Priority         @default(MEDIUM)
  status         WorkflowStatus   @default(ACTIVE)
  createdById    String
  dueDate        DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stages         WorkflowStage[]
  tasks          WorkflowTask[]
  comments       WorkflowComment[]

  @@index([organizationId])
  @@index([category])
  @@index([status])
}

model WorkflowStage {
  id                String         @id @default(uuid())
  workflowId        String
  name              String
  order             Int
  color             String         @default("#64748b")
  isCompletedStage  Boolean        @default(false)

  workflow          Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks             WorkflowTask[]

  @@index([workflowId])
}

model WorkflowTask {
  id          String             @id @default(uuid())
  workflowId  String
  stageId     String
  title       String
  description String?
  priority    Priority           @default(MEDIUM)
  assigneeId  String?
  reporterId  String?
  dueDate     DateTime?
  order       Int                @default(0)
  isCompleted Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workflow    Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stage       WorkflowStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignee    User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User?              @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  approvals   WorkflowApproval[]
  comments    WorkflowComment[]

  @@index([workflowId])
  @@index([stageId])
  @@index([assigneeId])
}

model WorkflowApproval {
  id         String         @id @default(uuid())
  taskId     String
  approverId String
  status     ApprovalStatus @default(PENDING)
  comments   String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  task       WorkflowTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approver   User           @relation("TaskApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([approverId])
}

model WorkflowComment {
  id         String        @id @default(uuid())
  workflowId String
  taskId     String?
  userId     String
  content    String
  createdAt  DateTime      @default(now())

  workflow   Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  task       WorkflowTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([taskId])
}

model TrainingProgram {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  description    String
  category       TrainingCategory   @default(REMOTE_FUNDAMENTALS)
  thumbnail      String?
  estimatedHours Float              @default(1.0)
  passingScore   Int                @default(80)
  status         TrainingStatus     @default(PUBLISHED)
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User               @relation("TrainingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  modules        TrainingModule[]
  enrollments    TrainingEnrollment[]
  quizzes        Quiz[]

  @@index([organizationId])
  @@index([category])
}

model TrainingModule {
  id          String           @id @default(uuid())
  programId   String
  title       String
  description String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  program     TrainingProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons     TrainingLesson[]

  @@index([programId])
}

model TrainingLesson {
  id              String           @id @default(uuid())
  moduleId        String
  title           String
  content         String           // Rich markdown/HTML
  contentType     LessonType       @default(ARTICLE)
  resourceUrl     String?
  durationMinutes Int              @default(10)
  order           Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  module          TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progressList    LessonProgress[]

  @@index([moduleId])
}

model TrainingEnrollment {
  id                  String             @id @default(uuid())
  programId           String
  userId              String
  organizationId      String
  status              EnrollmentStatus   @default(ENROLLED)
  progressPercent     Int                @default(0)
  certificateCode     String?            @unique
  certificateIssuedAt DateTime?
  completedAt         DateTime?
  enrolledAt          DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  program             TrainingProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]

  @@unique([programId, userId])
  @@index([userId])
  @@index([organizationId])
}

model LessonProgress {
  id           String             @id @default(uuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean            @default(true)
  completedAt  DateTime           @default(now())

  enrollment   TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       TrainingLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model Quiz {
  id               String          @id @default(uuid())
  programId        String
  title            String
  description      String?
  timeLimitMinutes Int             @default(15)
  passingScore     Int             @default(80)
  maxAttempts      Int             @default(3)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  program          TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  questions        Question[]
  attempts         QuizAttempt[]

  @@index([programId])
}

model Question {
  id           String         @id @default(uuid())
  quizId       String
  questionText String
  explanation  String?
  points       Int            @default(1)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())

  quiz         Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      AnswerOption[]

  @@index([quizId])
}

model AnswerOption {
  id         String   @id @default(uuid())
  questionId String
  optionText String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id               String             @id @default(uuid())
  quizId           String
  enrollmentId     String
  userId           String
  score            Int
  totalQuestions   Int
  correctQuestions Int
  isPassed         Boolean
  submittedAt      DateTime           @default(now())
  createdAt        DateTime           @default(now())

  quiz             Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  enrollment       TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([enrollmentId])
  @@index([userId])
}

model Workshop {
  id              String                 @id @default(uuid())
  organizationId  String
  title           String
  description     String
  instructorId    String?
  instructorName  String
  coverImage      String?
  scheduledAt     DateTime
  durationMinutes Int                    @default(60)
  timezone        String                 @default("UTC")
  meetingUrl      String?
  maxAttendees    Int                    @default(50)
  status          WorkshopStatus         @default(UPCOMING)
  materialsUrl    String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instructor      User?                  @relation("WorkshopInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  registrations   WorkshopRegistration[]
  attendance      WorkshopAttendance[]
  feedback        WorkshopFeedback[]

  @@index([organizationId])
  @@index([scheduledAt])
  @@index([status])
}

model WorkshopRegistration {
  id           String   @id @default(uuid())
  workshopId   String
  userId       String
  status       String   @default("REGISTERED") // REGISTERED, CANCELLED
  registeredAt DateTime @default(now())

  workshop     Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
  @@index([workshopId])
  @@index([userId])
}

model WorkshopAttendance {
  id                     String    @id @default(uuid())
  workshopId             String
  userId                 String
  joinedAt               DateTime  @default(now())
  leftAt                 DateTime?
  attendedDurationMinutes Int      @default(0)

  workshop               Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([userId])
}

model WorkshopFeedback {
  id         String   @id @default(uuid())
  workshopId String
  userId     String
  rating     Int      // 1 to 5
  comment    String?
  createdAt  DateTime @default(now())

  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workshopId, userId])
  @@index([workshopId])
}

model Notification {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  type           NotificationType @default(GENERAL)
  title          String
  message        String
  linkUrl        String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String       // e.g. "SOP_PUBLISHED", "WORKFLOW_CREATED", "TRAINING_COMPLETED"
  entityType     String       // e.g. "SOP", "WORKFLOW", "TRAINING", "USER"
  entityId       String
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Subscription {
  id                   String       @id @default(uuid())
  organizationId       String
  plan                 String       @default("ENTERPRISE")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String       @default("ACTIVE")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
