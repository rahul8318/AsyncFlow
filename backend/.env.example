NODE_ENV=production
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/asyncflow?schema=public"
JWT_SECRET=your-32-character-secret-key-goes-here
JWT_REFRESH_SECRET=your-32-character-refresh-secret-goes-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=https://app.asyncflow.io
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=./uploads
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-key
SMTP_FROM="AsyncFlow Enterprise <noreply@asyncflow.io>"
